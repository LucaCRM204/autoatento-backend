# ============================================
# AUTOATENTO — Variables de entorno (backend multi-tenant)
# Copiar a .env y completar. NUNCA versionar el .env.
# ============================================

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Desarrollo: una sola MySQL alcanza ---
# Si CONTROL_DB_URL / TENANT_DB_SERVER_URL están vacías, se arman desde acá:
#   CONTROL_DB_URL       = DEV_MYSQL_URL con base autoatento_control
#   TENANT_DB_SERVER_URL = DEV_MYSQL_URL sin base
DEV_MYSQL_URL=mysql://usuario:clave@host:3306/railway

# --- Base de control (tenants, superadmins, uso mensual, auditoría) ---
CONTROL_DB_URL=mysql://usuario:clave@host:3306/autoatento_control

# --- Servidor MySQL donde se crean los schemas crm_<slug> de tenants nuevos ---
TENANT_DB_SERVER_URL=mysql://usuario:clave@host:3306/

# --- Clave para cifrar connection strings y secretos de tenants (AES-256-GCM) ---
# 32 bytes en hex (64 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde, no se pueden descifrar las connection strings guardadas.
# Guardarla en el gestor de contraseñas: ver "Backup de secretos" en MULTITENANT.md.
TENANT_DB_KEY=

# --- Auth ---
JWT_SECRET=cambiar_esto_por_algo_largo_y_random
JWT_EXPIRES_IN=7d
# Panel superadmin: secreto separado del de los CRMs (mínimo 32 caracteres,
# distinto de JWT_SECRET; si falta, /api/superadmin responde 503)
SUPERADMIN_JWT_SECRET=
# SUPERADMIN_JWT_EXPIRES_IN=12h

# --- Subdominios automáticos ---
# Con BASE_DOMAIN=autoatento.com.ar, <slug>.autoatento.com.ar abre el CRM del
# tenant sin cargarlo en "dominios" (wildcard *.autoatento.com.ar en Vercel:
# ver MULTITENANT.md). Los dominios propios de cada cliente siguen funcionando.
# Vacío = solo dominios propios. En desarrollo <slug>.localhost funciona siempre.
BASE_DOMAIN=

# --- Migraciones: 1 = migrar los tenants activos al arrancar (npm run migrate a mano si no) ---
AUTO_MIGRATE=0

# --- Ajustes de tenancy (opcionales) ---
# TENANT_POOL_LIMIT=2            conexiones máximas por tenant (ver "Capacidad" en MULTITENANT.md)
# TENANT_POOL_IDLE_MS=1800000    cierre de pools sin uso (30 min)
# TENANT_CACHE_TTL_MS=30000      caché de la tabla tenants
# CONTROL_POOL_LIMIT=5
# CONTROL_DB_NAME=autoatento_control
# SUSPENSION_WATCH_MS=30000     cada cuánto se cortan sockets de tenants suspendidos

# --- Agente IA (fallback global: cada tenant puede tener su key en tenants.config) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-4o-mini
# AGENT_DISABLED=1               apaga los loops del agente
# AGENT_CONCURRENCY=4            tenants procesados en paralelo por el worker

# --- Bot de WhatsApp (fallback global) ---
# Cada tenant usa tenants.config.wa_bot_url / wa_bot_key. Dejalas VACÍAS en
# producción multi-tenant: si se completan, las usaría cualquier tenant sin bot propio.
# WA_BOT_URL=
# WA_BOT_KEY=

# --- Distribución (fallback global; por tenant: tenants.config.dist_excluidos) ---
# DIST_EXCLUIDOS=

# --- Solo desarrollo: contraseña de los usuarios de npm run dev:seed ---
DEV_TENANT_PASSWORD=

# --- Solo para scripts, pasar en la línea de comandos (no dejar en el .env) ---
# SUPERADMIN_PASSWORD   npm run superadmin:add
# OWNER_PASSWORD        npm run tenant:add --create-schema

# Ya NO se usan (eran de la instalación de un solo cliente):
#   DATABASE_URL, DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME  -> connection string por tenant
#   LEAD_API_KEYS   -> tenants.config.lead_api_keys (por tenant, cifradas)
#   AGENT_MCP_KEY   -> tenants.config.agent_mcp_key (por tenant, cifrada)
#   CORS_ORIGIN     -> no se usaba (CORS acepta cualquier origen con credenciales)
